{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "package_id",
    "state_id",
    "state_sha256",
    "origin",
    "method",
    "atom_map",
    "assets",
    "compatibility",
    "charge_sum_e",
    "qc"
  ],
  "properties": {
    "schema_id": {
      "const": "urn:neodyn:component-preparation:v1:parameter-package"
    },
    "schema_version": {
      "const": 1
    },
    "package_id": {
      "type": "string",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "state_id": {
      "type": "string",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "state_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "origin": {
      "enum": [
        "generated",
        "imported"
      ]
    },
    "method": {
      "$ref": "#/$defs/method"
    },
    "atom_map": {
      "allOf": [
        {
          "$ref": "#/$defs/artifact_reference"
        },
        {
          "properties": {
            "kind": {
              "const": "atom_map"
            }
          }
        }
      ]
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/artifact_reference"
          },
          {
            "properties": {
              "kind": {
                "const": "parameter_asset"
              }
            }
          }
        ]
      }
    },
    "compatibility": {
      "$ref": "#/$defs/compatibility"
    },
    "charge_sum_e": {
      "type": "number"
    },
    "qc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "report"
      ],
      "properties": {
        "status": {
          "enum": [
            "unreviewed",
            "integrity_passed",
            "numerically_executable",
            "scientifically_qualified",
            "blocked"
          ]
        },
        "report": {
          "allOf": [
            {
              "$ref": "#/$defs/artifact_reference"
            },
            {
              "properties": {
                "kind": {
                  "const": "qc_report"
                }
              }
            }
          ]
        }
      }
    },
    "attachment_sites": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state_atom_id",
          "partner_instance_id",
          "partner_state_atom_id",
          "interface_terms"
        ],
        "properties": {
          "state_atom_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          },
          "partner_instance_id": {
            "type": "string",
            "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "partner_state_atom_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          },
          "interface_terms": {
            "allOf": [
              {
                "$ref": "#/$defs/artifact_reference"
              },
              {
                "properties": {
                  "kind": {
                    "const": "parameter_asset"
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neodyn:component-preparation:v1:parameter-package",
  "title": "State-bound immutable parameter package manifest",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "atom_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "artifact_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "artifact_id",
        "kind",
        "content_sha256",
        "size_bytes",
        "decoded_size_bytes",
        "encoding",
        "media_type"
      ],
      "properties": {
        "schema_id": {
          "const": "urn:neodyn:component-preparation:v1:artifact-reference"
        },
        "schema_version": {
          "const": 1
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "kind": {
          "enum": [
            "chemical_state",
            "component_instance",
            "parameter_package",
            "parameter_asset",
            "atom_map",
            "qc_report",
            "preparation_recipe",
            "prepared_bundle",
            "analysis"
          ]
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912
        },
        "decoded_size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912
        },
        "encoding": {
          "enum": [
            "identity",
            "gzip"
          ]
        },
        "media_type": {
          "enum": [
            "application/json",
            "application/octet-stream",
            "application/gzip"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_sha256",
        "detail"
      ],
      "properties": {
        "kind": {
          "enum": [
            "ccd",
            "source_structure",
            "user_decision",
            "calculation",
            "publication"
          ]
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "atom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "element",
        "formal_charge",
        "stereo"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "element": {
          "type": "string",
          "pattern": "^[A-Z][a-z]?$"
        },
        "formal_charge": {
          "type": "integer",
          "minimum": -8,
          "maximum": 8
        },
        "stereo": {
          "enum": [
            "R",
            "S",
            "none",
            "unresolved"
          ]
        }
      }
    },
    "bond": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atom_ids",
        "order",
        "stereo"
      ],
      "properties": {
        "atom_ids": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "order": {
          "enum": [
            "single",
            "double",
            "triple",
            "aromatic"
          ]
        },
        "stereo": {
          "enum": [
            "E",
            "Z",
            "none",
            "unresolved"
          ]
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_atom_id",
        "source_atom_id"
      ],
      "properties": {
        "state_atom_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "source_atom_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        }
      }
    },
    "tool_version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "version"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "resource_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "sha256"
      ],
      "properties": {
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method_id",
        "version",
        "charge_method_id",
        "tool_versions",
        "resource_hashes",
        "options_sha256",
        "conformer_sha256",
        "seed"
      ],
      "properties": {
        "method_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "charge_method_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "tool_versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/tool_version"
          }
        },
        "resource_hashes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/resource_hash"
          }
        },
        "options_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "conformer_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protein_family",
        "ligand_family",
        "water_family",
        "ion_family",
        "combining_rule",
        "electrostatic_14_scale",
        "vdw_14_scale",
        "unit_system",
        "nonbonded_method",
        "cutoff_nm",
        "switch_distance_nm",
        "constraints",
        "hydrogen_mass_amu",
        "virtual_sites"
      ],
      "properties": {
        "protein_family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "ligand_family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "water_family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "ion_family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "combining_rule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "electrostatic_14_scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "vdw_14_scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit_system": {
          "const": "openmm_nm_kj_mol_e"
        },
        "nonbonded_method": {
          "enum": [
            "pme",
            "cutoff_periodic",
            "no_cutoff"
          ]
        },
        "cutoff_nm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "switch_distance_nm": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "constraints": {
          "enum": [
            "none",
            "HBonds",
            "AllBonds",
            "HAngles"
          ]
        },
        "hydrogen_mass_amu": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "virtual_sites": {
          "type": "boolean"
        }
      }
    }
  }
}
