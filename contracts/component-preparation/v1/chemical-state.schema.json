{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "state_id",
    "atoms",
    "bonds",
    "net_formal_charge",
    "hydrogen_policy",
    "tautomer_id",
    "protonation_id",
    "review"
  ],
  "properties": {
    "schema_id": {
      "const": "urn:neodyn:component-preparation:v1:chemical-state"
    },
    "schema_version": {
      "const": 1
    },
    "state_id": {
      "type": "string",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "atoms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/atom"
      }
    },
    "bonds": {
      "type": "array",
      "minItems": 0,
      "maxItems": 200000,
      "items": {
        "$ref": "#/$defs/bond"
      }
    },
    "net_formal_charge": {
      "type": "integer",
      "minimum": -100000,
      "maximum": 100000
    },
    "hydrogen_policy": {
      "enum": [
        "explicit_all",
        "reviewed_addition"
      ]
    },
    "tautomer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "protonation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "decision_id",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "accepted",
            "blocked"
          ]
        },
        "decision_id": {
          "type": "string",
          "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neodyn:component-preparation:v1:chemical-state",
  "title": "Reviewed immutable chemical state graph",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "atom_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "artifact_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "artifact_id",
        "kind",
        "content_sha256",
        "size_bytes",
        "decoded_size_bytes",
        "encoding",
        "media_type"
      ],
      "properties": {
        "schema_id": {
          "const": "urn:neodyn:component-preparation:v1:artifact-reference"
        },
        "schema_version": {
          "const": 1
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "kind": {
          "enum": [
            "chemical_state",
            "component_instance",
            "parameter_package",
            "parameter_asset",
            "atom_map",
            "qc_report",
            "preparation_recipe",
            "prepared_bundle",
            "analysis"
          ]
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912
        },
        "decoded_size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912
        },
        "encoding": {
          "enum": [
            "identity",
            "gzip"
          ]
        },
        "media_type": {
          "enum": [
            "application/json",
            "application/octet-stream",
            "application/gzip"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_sha256",
        "detail"
      ],
      "properties": {
        "kind": {
          "enum": [
            "ccd",
            "source_structure",
            "user_decision",
            "calculation",
            "publication"
          ]
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "atom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "element",
        "formal_charge",
        "stereo"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "element": {
          "type": "string",
          "pattern": "^[A-Z][a-z]?$"
        },
        "formal_charge": {
          "type": "integer",
          "minimum": -8,
          "maximum": 8
        },
        "stereo": {
          "enum": [
            "R",
            "S",
            "none",
            "unresolved"
          ]
        }
      }
    },
    "bond": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atom_ids",
        "order",
        "stereo"
      ],
      "properties": {
        "atom_ids": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "order": {
          "enum": [
            "single",
            "double",
            "triple",
            "aromatic"
          ]
        },
        "stereo": {
          "enum": [
            "E",
            "Z",
            "none",
            "unresolved"
          ]
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_atom_id",
        "source_atom_id"
      ],
      "properties": {
        "state_atom_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "source_atom_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        }
      }
    },
    "tool_version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "version"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "resource_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "sha256"
      ],
      "properties": {
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
