{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neodyn:coordinate-reference:v1",
  "title": "Immutable full System-row coordinate reference",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "reference_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "prepared_revision_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "particle_identity_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dtype": {
      "const": "float64"
    },
    "byte_order": {
      "const": "little"
    },
    "unit": {
      "const": "nm"
    },
    "frame_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "particle_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schema_version",
    "reference_id",
    "prepared_revision_id",
    "particle_identity_sha256",
    "content_sha256",
    "dtype",
    "byte_order",
    "unit",
    "frame_count",
    "particle_count",
    "size_bytes"
  ]
}
