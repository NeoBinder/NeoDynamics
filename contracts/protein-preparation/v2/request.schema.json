{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neodyn:protein-preparation:v2:request",
  "title": "Explicit-topology protein preparation request v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "request_id": {
      "$ref": "#/$defs/uuid"
    },
    "source": {
      "$ref": "#/$defs/PreparationSource"
    },
    "preset_id": {
      "type": "string",
      "minLength": 1
    },
    "preset_revision_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "parameters": {
      "$ref": "#/$defs/PreparationParameters"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "source",
    "preset_id",
    "preset_revision_sha256",
    "parameters"
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "SourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "complex_id",
        "revision_id",
        "revision_content_sha256"
      ],
      "properties": {
        "project_id": {
          "$ref": "#/$defs/uuid"
        },
        "complex_id": {
          "$ref": "#/$defs/uuid"
        },
        "revision_id": {
          "$ref": "#/$defs/uuid"
        },
        "revision_content_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "PreparationParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ph",
        "ionic_strength_mol_per_l",
        "padding_nm"
      ],
      "properties": {
        "ph": {
          "type": "number",
          "minimum": 0,
          "maximum": 14
        },
        "ionic_strength_mol_per_l": {
          "type": "number",
          "minimum": 0
        },
        "padding_nm": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "PreparationSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_upload_id": {
          "$ref": "#/$defs/uuid"
        },
        "format": {
          "const": "molecular-topology-v1+gzip"
        },
        "schema_id": {
          "const": "urn:neodyn:molecular-topology:v1"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "decoded_size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "topology_revision_id": {
          "$ref": "#/$defs/uuid"
        },
        "identity": {
          "$ref": "#/$defs/SourceIdentity"
        }
      },
      "required": [
        "source_upload_id",
        "format",
        "schema_id",
        "content_sha256",
        "size_bytes",
        "decoded_size_bytes",
        "topology_revision_id",
        "identity"
      ]
    }
  }
}
