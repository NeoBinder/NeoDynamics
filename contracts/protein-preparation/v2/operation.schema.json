{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neodyn:protein-preparation:v2:operation",
  "title": "Durable explicit-topology protein and ligand preparation operation",
  "type": "object",
  "$ref": "#/$defs/PreparationOperation",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "enum": [
            "invalid_request",
            "authentication_required",
            "forbidden",
            "not_found",
            "idempotency_conflict",
            "request_conflict",
            "preset_revision_mismatch",
            "preparation_terminal",
            "unsupported_structure",
            "evidence_mismatch",
            "protonation_conflict",
            "verification_failed",
            "preparation_time_limit_exceeded",
            "preparation_memory_limit_exceeded",
            "result_too_large",
            "outcome_indeterminate",
            "payload_too_large",
            "admission_full",
            "service_unavailable",
            "worker_lost",
            "connectivity_incomplete",
            "invalid_topology_record",
            "unsupported_relation"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 512
        },
        "retryable": {
          "type": "boolean"
        },
        "request_id": {
          "$ref": "#/$defs/uuid"
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "PreparationRequest": {
      "$ref": "urn:neodyn:protein-preparation:v2:request"
    },
    "SourceUploadBeginRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "format",
        "schema_id",
        "content_sha256",
        "size_bytes",
        "decoded_size_bytes",
        "topology_revision_id"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "request_id": {
          "$ref": "#/$defs/uuid"
        },
        "format": {
          "const": "molecular-topology-v1+gzip"
        },
        "schema_id": {
          "const": "urn:neodyn:molecular-topology:v1"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "decoded_size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "topology_revision_id": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "SourceUploadReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "upload_id",
        "request_id",
        "format",
        "schema_id",
        "content_sha256",
        "size_bytes",
        "decoded_size_bytes",
        "topology_revision_id",
        "state",
        "created_at"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "request_id": {
          "$ref": "#/$defs/uuid"
        },
        "format": {
          "const": "molecular-topology-v1+gzip"
        },
        "schema_id": {
          "const": "urn:neodyn:molecular-topology:v1"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "decoded_size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "topology_revision_id": {
          "$ref": "#/$defs/uuid"
        },
        "upload_id": {
          "$ref": "#/$defs/uuid"
        },
        "state": {
          "enum": [
            "registered",
            "stored"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "PreparationOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation_id",
        "request_id",
        "kind",
        "revision",
        "state",
        "request",
        "request_sha256",
        "receipt",
        "error",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "operation_id": {
          "$ref": "#/$defs/uuid"
        },
        "request_id": {
          "$ref": "#/$defs/uuid"
        },
        "kind": {
          "const": "topology_preparation"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled",
            "interrupted"
          ]
        },
        "request": {
          "$ref": "#/$defs/PreparationRequest"
        },
        "request_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "receipt": {
          "oneOf": [
            {
              "$ref": "urn:neodyn:protein-preparation:v2:receipt"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "oneOf": [
            {
              "$ref": "#/$defs/Error"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "succeeded"
              }
            }
          },
          "then": {
            "properties": {
              "receipt": {
                "$ref": "urn:neodyn:protein-preparation:v2:receipt"
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "queued",
                  "running"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "receipt": {
                "type": "null"
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "failed",
                  "interrupted"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "receipt": {
                "type": "null"
              },
              "error": {
                "$ref": "#/$defs/Error"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "cancelled"
              }
            }
          },
          "then": {
            "properties": {
              "receipt": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
