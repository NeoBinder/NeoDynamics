{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neodyn:protein-preparation:v1:inventory",
  "title": "Complete preparation artifact inventory with exact bytes and opaque access identities",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "receipt_id",
    "prepared_revision_id",
    "artifacts",
    "total_size_bytes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation_id": {
      "$ref": "#/$defs/uuid"
    },
    "receipt_id": {
      "$ref": "#/$defs/uuid"
    },
    "prepared_revision_id": {
      "$ref": "#/$defs/uuid"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "role",
          "path",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "artifact_id": {
            "$ref": "#/$defs/uuid"
          },
          "role": {
            "enum": [
              "manifest",
              "topology",
              "system",
              "coordinates",
              "mapping",
              "report",
              "source",
              "forcefield",
              "log"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.\\-/]+$"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "total_size_bytes": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
