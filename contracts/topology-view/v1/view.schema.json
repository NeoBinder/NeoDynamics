{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neodyn:topology-view:v1:view",
  "title": "Immutable prepared topology projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prepared",
    "prepared_schema_version",
    "particle_count",
    "topology_atom_count",
    "coordinate_unit",
    "collections",
    "view_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "prepared": {
      "$ref": "#/$defs/PreparedBinding"
    },
    "prepared_schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "particle_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "topology_atom_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "coordinate_unit": {
      "const": "nm"
    },
    "collections": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "row_count",
            "pages"
          ],
          "properties": {
            "kind": {
              "const": "atoms"
            },
            "row_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "pages": {
              "type": "array",
              "maxItems": 4096,
              "items": {
                "$ref": "#/$defs/PageDescriptor"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "row_count",
            "pages"
          ],
          "properties": {
            "kind": {
              "const": "residues"
            },
            "row_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "pages": {
              "type": "array",
              "maxItems": 4096,
              "items": {
                "$ref": "#/$defs/PageDescriptor"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "row_count",
            "pages"
          ],
          "properties": {
            "kind": {
              "const": "bonds"
            },
            "row_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "pages": {
              "type": "array",
              "maxItems": 4096,
              "items": {
                "$ref": "#/$defs/PageDescriptor"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "row_count",
            "pages"
          ],
          "properties": {
            "kind": {
              "const": "particles"
            },
            "row_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "pages": {
              "type": "array",
              "maxItems": 4096,
              "items": {
                "$ref": "#/$defs/PageDescriptor"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "row_count",
            "pages"
          ],
          "properties": {
            "kind": {
              "const": "topology_particle_indices"
            },
            "row_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "pages": {
              "type": "array",
              "maxItems": 4096,
              "items": {
                "$ref": "#/$defs/PageDescriptor"
              }
            }
          }
        }
      ]
    },
    "view_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "PreparedBinding": {
      "type": "object",
      "properties": {
        "bundle_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "prepared_revision_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mapping_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "bundle_id",
        "prepared_revision_id",
        "manifest_sha256",
        "mapping_sha256"
      ],
      "additionalProperties": false
    },
    "PageDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_index",
        "first_row",
        "row_count",
        "size_bytes",
        "content_sha256"
      ],
      "properties": {
        "page_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        },
        "first_row": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "row_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
