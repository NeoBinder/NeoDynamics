{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neodyn:topology-view:v1:page",
  "title": "Canonical bounded topology page",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prepared",
    "prepared_schema_version",
    "kind",
    "page_index",
    "first_row",
    "rows"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "prepared": {
      "$ref": "urn:neodyn:topology-view:v1:view#/$defs/PreparedBinding"
    },
    "prepared_schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "kind": {
      "enum": [
        "atoms",
        "residues",
        "bonds",
        "particles",
        "topology_particle_indices"
      ]
    },
    "page_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4095
    },
    "first_row": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "prepared_schema_version": {
            "const": 1
          },
          "kind": {
            "const": "atoms"
          }
        }
      },
      "then": {
        "properties": {
          "rows": {
            "items": {
              "$ref": "urn:neodyn:prepared-bundle:v1:manifest#/$defs/atom"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "prepared_schema_version": {
            "const": 1
          },
          "kind": {
            "const": "residues"
          }
        }
      },
      "then": {
        "properties": {
          "rows": {
            "items": {
              "$ref": "urn:neodyn:prepared-bundle:v1:manifest#/$defs/residue"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "prepared_schema_version": {
            "const": 1
          },
          "kind": {
            "const": "bonds"
          }
        }
      },
      "then": {
        "properties": {
          "rows": {
            "items": {
              "$ref": "urn:neodyn:prepared-bundle:v1:manifest#/$defs/bond"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "prepared_schema_version": {
            "const": 1
          },
          "kind": {
            "const": "particles"
          }
        }
      },
      "then": {
        "properties": {
          "rows": {
            "items": {
              "$ref": "urn:neodyn:prepared-bundle:v1:manifest#/$defs/particle"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "prepared_schema_version": {
            "const": 1
          },
          "kind": {
            "const": "topology_particle_indices"
          }
        }
      },
      "then": {
        "properties": {
          "rows": {
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "prepared_schema_version": {
            "const": 2
          },
          "kind": {
            "const": "atoms"
          }
        }
      },
      "then": {
        "properties": {
          "rows": {
            "items": {
              "$ref": "urn:neodyn:prepared-bundle:v2:manifest#/$defs/atom"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "prepared_schema_version": {
            "const": 2
          },
          "kind": {
            "const": "residues"
          }
        }
      },
      "then": {
        "properties": {
          "rows": {
            "items": {
              "$ref": "urn:neodyn:prepared-bundle:v2:manifest#/$defs/residue"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "prepared_schema_version": {
            "const": 2
          },
          "kind": {
            "const": "bonds"
          }
        }
      },
      "then": {
        "properties": {
          "rows": {
            "items": {
              "$ref": "urn:neodyn:prepared-bundle:v2:manifest#/$defs/bond"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "prepared_schema_version": {
            "const": 2
          },
          "kind": {
            "const": "particles"
          }
        }
      },
      "then": {
        "properties": {
          "rows": {
            "items": {
              "$ref": "urn:neodyn:prepared-bundle:v2:manifest#/$defs/particle"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "prepared_schema_version": {
            "const": 2
          },
          "kind": {
            "const": "topology_particle_indices"
          }
        }
      },
      "then": {
        "properties": {
          "rows": {
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      }
    }
  ]
}
