{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neodyn:component-operations:v1:qc",
  "title": "Bounded component verification summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "receipt_id",
    "outcome",
    "report_sha256",
    "summary",
    "blockers"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation_id": {
      "$ref": "#/$defs/uuid"
    },
    "receipt_id": {
      "$ref": "#/$defs/uuid"
    },
    "outcome": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "report_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "summary": {
      "type": "string",
      "maxLength": 1024
    },
    "blockers": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/Blocker"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "passed"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "blockers": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "detail"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "detail": {
          "type": "string",
          "maxLength": 512
        }
      }
    }
  }
}
