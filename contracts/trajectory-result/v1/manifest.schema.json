{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "neomd-server"
        },
        "neomd_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9.+_-]+$"
        },
        "openmm_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9.+_-]+$"
        },
        "platform": {
          "enum": [
            "cpu",
            "cuda"
          ]
        }
      },
      "required": [
        "name",
        "neomd_version",
        "openmm_version",
        "platform"
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "attempt_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "method": {
          "enum": [
            "min",
            "eq",
            "md",
            "prod",
            "metadynamics",
            "smd",
            "opes",
            "gamd",
            "rbfe"
          ]
        },
        "terminal_state": {
          "enum": [
            "completed",
            "stopped",
            "failed"
          ]
        },
        "step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "time_ps": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "control_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "session_id",
        "attempt_id",
        "generation",
        "epoch",
        "method",
        "terminal_state",
        "step",
        "time_ps",
        "control_revision"
      ],
      "description": "Actual owner-thread terminal observation. Failed identifies a sealed diagnostic result, never completed science or an eligible continuation."
    },
    "prepared": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bundle_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "prepared_revision_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mapping_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "bundle_id",
        "prepared_revision_id",
        "manifest_sha256",
        "mapping_sha256"
      ]
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA256(JCS({prepared: complete PreparedBinding, protocol: registered scientific descriptor})); excludes protocol_id/request_id and differs from a descriptor-only hash."
        }
      },
      "required": [
        "protocol_id",
        "content_sha256"
      ]
    },
    "particles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "order": {
          "const": "system_particle_index"
        },
        "identity_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA256(JCS(ordered manifest.particles identity_id UUID strings)), including all atom/site rows in System particle-index order."
        }
      },
      "required": [
        "count",
        "order",
        "identity_sha256"
      ]
    },
    "trajectory_state": {
      "enum": [
        "written",
        "not_written",
        "unverified"
      ]
    },
    "trajectories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "encoding": {
            "const": "dcd_charmm24_le"
          },
          "coordinate_dtype": {
            "const": "float32"
          },
          "coordinate_unit": {
            "const": "angstrom"
          },
          "frame_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "first_step": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "last_step": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "interval_steps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "timestep_ps": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "periodic": {
            "type": "boolean"
          },
          "series": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "run"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "rbfe_window"
                  },
                  "window_index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "window_count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "lambda_values": {
                    "type": "object",
                    "minProperties": 1,
                    "propertyNames": {
                      "pattern": "^lambda_[A-Za-z0-9_]{1,64}$"
                    },
                    "additionalProperties": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                },
                "required": [
                  "kind",
                  "window_index",
                  "window_count",
                  "lambda_values"
                ]
              }
            ]
          }
        },
        "required": [
          "artifact_id",
          "content_sha256",
          "size_bytes",
          "encoding",
          "coordinate_dtype",
          "coordinate_unit",
          "frame_count",
          "first_step",
          "last_step",
          "interval_steps",
          "timestep_ps",
          "periodic",
          "series"
        ],
        "description": "One sealed DCD segment. artifact_id is its immutable segment identity. Frame k has local step first_step+k*interval_steps and time_ps=step*timestep_ps. RBFE times are window-local, not a continuous concatenated trajectory. timestep_ps is the stored f32 AKMA header value multiplied by 0.04888821; it may differ from the requested timestep due to header rounding.",
        "allOf": [
          {
            "if": {
              "properties": {
                "frame_count": {
                  "const": 0
                }
              }
            },
            "then": {
              "properties": {
                "last_step": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "last_step": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            }
          }
        ]
      }
    },
    "final_state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "encoding": {
          "const": "f64le_positions_box_v1"
        },
        "unit": {
          "const": "nm"
        },
        "particle_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "particle_identity_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "artifact_id",
        "content_sha256",
        "size_bytes",
        "encoding",
        "unit",
        "particle_count",
        "particle_identity_sha256"
      ]
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "const": "scientific_step_failed"
        },
        "exception_type": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
        }
      },
      "required": [
        "code",
        "exception_type"
      ]
    },
    "diagnostic_artifacts": {
      "type": "array",
      "maxItems": 4095,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "artifact_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": [
          "name",
          "artifact_id",
          "content_sha256",
          "size_bytes",
          "kind"
        ]
      }
    },
    "input_continuation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_session_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "source_finalization_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "source_result_artifact_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "final_state_artifact_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "final_state_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "velocity_policy": {
          "const": "reinitialize_at_target_temperature"
        }
      },
      "required": [
        "source_session_id",
        "source_finalization_id",
        "source_result_artifact_id",
        "final_state_artifact_id",
        "final_state_sha256",
        "velocity_policy"
      ]
    }
  },
  "required": [
    "schema_version",
    "producer",
    "execution",
    "prepared",
    "protocol",
    "particles",
    "trajectory_state",
    "trajectories"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neodyn:trajectory-result:v1",
  "title": "Sealed NeoDynamics trajectory result evidence",
  "allOf": [
    {
      "if": {
        "properties": {
          "trajectory_state": {
            "const": "written"
          }
        }
      },
      "then": {
        "properties": {
          "trajectories": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "trajectories": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "method": {
                "const": "rbfe"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "trajectories": {
            "items": {
              "properties": {
                "series": {
                  "properties": {
                    "kind": {
                      "const": "rbfe_window"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "trajectories": {
            "items": {
              "properties": {
                "series": {
                  "properties": {
                    "kind": {
                      "const": "run"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "terminal_state": {
                "const": "failed"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "failure",
          "diagnostic_artifacts"
        ],
        "properties": {
          "trajectory_state": {
            "const": "unverified"
          }
        },
        "not": {
          "required": [
            "final_state"
          ]
        }
      },
      "else": {
        "properties": {
          "trajectory_state": {
            "enum": [
              "written",
              "not_written"
            ]
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "failure"
              ]
            },
            {
              "required": [
                "diagnostic_artifacts"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "final_state"
        ]
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "terminal_state": {
                "const": "completed"
              },
              "method": {
                "enum": [
                  "min",
                  "eq"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
