{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neodyn:prepared-bundle:v1:manifest",
  "title": "NeoDynamics immutable prepared scientific bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "prepared_revision_id", "sources", "atoms", "residues", "bonds", "particles", "preparation_steps", "particle_count", "topology_atom_count", "topology_particle_indices", "versions", "parameters", "box_vectors_nm", "coordinates", "mapping_artifact", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "prepared_revision_id": {"$ref": "#/$defs/uuid"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "atoms": {"type": "array", "items": {"$ref": "#/$defs/atom"}},
    "residues": {"type": "array", "items": {"$ref": "#/$defs/residue"}},
    "bonds": {"type": "array", "items": {"$ref": "#/$defs/bond"}},
    "particles": {"type": "array", "items": {"$ref": "#/$defs/particle"}},
    "preparation_steps": {"type": "array", "items": {"$ref": "#/$defs/step"}},
    "particle_count": {"type": "integer", "minimum": 0},
    "topology_atom_count": {"type": "integer", "minimum": 0},
    "topology_particle_indices": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
    "versions": {"type": "object", "additionalProperties": {"type": "string"}},
    "parameters": {"type": "object"},
    "box_vectors_nm": {"oneOf": [{"type": "null"}, {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/xyz"}}]},
    "coordinates": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact", "dtype", "byte_order", "unit", "shape", "order", "wrapping"],
      "properties": {
        "artifact": {"const": "coordinates.f64le"}, "dtype": {"const": "float64"},
        "byte_order": {"const": "little"}, "unit": {"const": "nm"},
        "shape": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0}, {"const": 3}], "minItems": 2, "maxItems": 2},
        "order": {"const": "particle_index"}, "wrapping": {"const": "unwrapped"}
      }
    },
    "mapping_artifact": {"const": "mapping.json"},
    "artifacts": {"type": "object", "required": ["mapping.json", "coordinates.f64le", "system.xml"], "additionalProperties": {"$ref": "#/$defs/artifact"}}
  },
  "$defs": {
    "uuid": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "nullableUuid": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "xyz": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "element": {"oneOf": [{"type": "string", "pattern": "^[A-Z][a-z]?$"}, {"type": "null"}]},
    "loader": {
      "type": "object", "additionalProperties": false, "required": ["name", "version", "atom_order"],
      "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "atom_order": {"const": "preparation_input"}}
    },
    "inputAtom": {
      "type": "object", "additionalProperties": false,
      "required": ["input_atom_index", "source_atom_id", "source_residue_id", "element", "position_nm"],
      "properties": {
        "input_atom_index": {"type": "integer", "minimum": 0}, "source_atom_id": {"$ref": "#/$defs/uuid"},
        "source_residue_id": {"$ref": "#/$defs/uuid"}, "element": {"$ref": "#/$defs/element"}, "position_nm": {"$ref": "#/$defs/xyz"}
      }
    },
    "sourceAtom": {
      "type": "object", "additionalProperties": false,
      "required": ["input_atom_index", "source_atom_id", "source_residue_id", "element", "position_nm", "prepared_atom_id", "disposition"],
      "properties": {
        "input_atom_index": {"type": "integer", "minimum": 0}, "source_atom_id": {"$ref": "#/$defs/uuid"},
        "source_residue_id": {"$ref": "#/$defs/uuid"}, "element": {"$ref": "#/$defs/element"}, "position_nm": {"$ref": "#/$defs/xyz"},
        "prepared_atom_id": {"$ref": "#/$defs/nullableUuid"}, "disposition": {"enum": ["retained", "removed_by_hydrogenation"]}
      }
    },
    "sourceBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["input_key", "kind", "source_id", "content_sha256", "loader", "atom_bindings"],
      "properties": {
        "input_key": {"type": "string", "minLength": 1},
        "kind": {"enum": ["canonical_structure", "structure", "ligand", "amber", "gromacs", "prepared"]},
        "source_id": {"$ref": "#/$defs/uuid"}, "content_sha256": {"$ref": "#/$defs/sha256"},
        "client_revision_id": {"$ref": "#/$defs/uuid"}, "loader": {"$ref": "#/$defs/loader"},
        "atom_bindings": {"type": "array", "items": {"$ref": "#/$defs/inputAtom"}}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "input_key", "kind", "content_sha256", "artifact", "loader", "atoms", "binding_tolerance_nm"],
      "properties": {
        "source_id": {"$ref": "#/$defs/uuid"}, "input_key": {"type": "string", "minLength": 1},
        "kind": {"enum": ["canonical_structure", "structure", "ligand", "amber", "gromacs", "prepared"]},
        "content_sha256": {"$ref": "#/$defs/sha256"}, "artifact": {"type": "string", "minLength": 1},
        "loader": {"$ref": "#/$defs/loader"}, "atoms": {"type": "array", "items": {"$ref": "#/$defs/sourceAtom"}},
        "binding_tolerance_nm": {"const": 0.000001}, "client_revision_id": {"$ref": "#/$defs/uuid"}
      }
    },
    "atom": {
      "type": "object", "additionalProperties": false,
      "required": ["atom_id", "residue_id", "name", "element", "formal_charge", "origin", "parent_ids", "source_atom_id", "source_id"],
      "properties": {
        "atom_id": {"$ref": "#/$defs/uuid"}, "residue_id": {"$ref": "#/$defs/uuid"}, "name": {"type": "string"},
        "element": {"$ref": "#/$defs/element"}, "formal_charge": {"type": ["integer", "null"]},
        "origin": {"enum": ["source", "generated_hydrogen", "solvent", "ion"]},
        "parent_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/uuid"}},
        "source_atom_id": {"$ref": "#/$defs/nullableUuid"}, "source_id": {"$ref": "#/$defs/nullableUuid"}
      }
    },
    "residue": {
      "type": "object", "additionalProperties": false,
      "required": ["residue_id", "name", "chain_label", "sequence_label", "insertion_code", "source_residue_id"],
      "properties": {
        "residue_id": {"$ref": "#/$defs/uuid"}, "name": {"type": "string"}, "chain_label": {"type": "string"},
        "sequence_label": {"type": "string"}, "insertion_code": {"type": "string"}, "source_residue_id": {"$ref": "#/$defs/nullableUuid"}
      }
    },
    "bond": {
      "type": "object", "additionalProperties": false, "required": ["atom_ids", "order", "type"],
      "properties": {"atom_ids": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/uuid"}}, "order": {"type": ["number", "null"]}, "type": {"type": ["string", "null"]}}
    },
    "virtualSite": {
      "type": "object", "additionalProperties": false, "required": ["type", "parent_indices", "parent_ids"],
      "properties": {
        "type": {"enum": ["TwoParticleAverageSite", "ThreeParticleAverageSite", "OutOfPlaneSite", "LocalCoordinatesSite"]},
        "parent_indices": {"type": "array", "minItems": 2, "items": {"type": "integer", "minimum": 0}},
        "parent_ids": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/uuid"}},
        "weights": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"type": "number"}},
        "cross_weight_unit": {"const": "1/nm"}, "origin_weights": {"type": "array", "items": {"type": "number"}},
        "x_weights": {"type": "array", "items": {"type": "number"}}, "y_weights": {"type": "array", "items": {"type": "number"}},
        "local_position_nm": {"$ref": "#/$defs/xyz"}
      }
    },
    "particle": {
      "type": "object", "additionalProperties": false,
      "required": ["particle_index", "identity_id", "identity_kind", "topology_atom_id", "mass_dalton", "origin", "control_eligible", "control_ineligibility", "virtual_site"],
      "properties": {
        "particle_index": {"type": "integer", "minimum": 0}, "identity_id": {"$ref": "#/$defs/uuid"},
        "identity_kind": {"enum": ["atom", "site"]}, "topology_atom_id": {"$ref": "#/$defs/nullableUuid"},
        "mass_dalton": {"type": "number", "minimum": 0},
        "origin": {"enum": ["source", "generated_hydrogen", "solvent", "ion", "system_virtual_site"]},
        "control_eligible": {"type": "boolean"}, "control_ineligibility": {"enum": [null, "virtual_site", "zero_mass"]},
        "virtual_site": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/virtualSite"}]}
      }
    },
    "step": {
      "type": "object", "additionalProperties": false, "required": ["operation"],
      "properties": {
        "operation": {"enum": ["load", "add_hydrogens", "add_solvent", "translate"]},
        "input_key": {"type": "string"}, "atom_count": {"type": "integer", "minimum": 0},
        "generated_count": {"type": "integer", "minimum": 0},
        "removed_source_atoms": {"type": "array", "items": {"$ref": "#/$defs/uuid"}},
        "translation_nm": {"$ref": "#/$defs/xyz"}, "residue_variants": {"type": "array"},
        "ionic_strength_molar": {"type": "number", "minimum": 0}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["sha256", "size_bytes"],
      "properties": {"sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 0}}
    }
  }
}
